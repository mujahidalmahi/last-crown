# ==============================================================================
# LAST CROWN — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or app-specific `.env.local` files for development.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Application Settings (apps/web)
# ------------------------------------------------------------------------------
# Public URL of the frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public WebSocket URL for the Colyseus game server
# For local development: ws://localhost:2567
# For production: wss://your-colyseus-server.example.com
NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:2567

# Public HTTP URL for room creation & query endpoints
NEXT_PUBLIC_SERVER_HTTP_URL=http://localhost:2567

# Optional client logging level: debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Multiplayer Server Settings (apps/server)
# ------------------------------------------------------------------------------
# Node runtime environment: development | production | test
NODE_ENV=development

# Server bind host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=2567

# Allowed Web Origins for CORS (comma-separated if multiple)
SERVER_CORS_ORIGIN=http://localhost:3000

# Server logging level: trace | debug | info | warn | error
SERVER_LOG_LEVEL=info

# Invite code rate limiting: maximum room join attempts per window per IP
SERVER_RATE_LIMIT_JOIN_MAX=10
SERVER_RATE_LIMIT_JOIN_WINDOW_MS=60000

# Room configuration
SERVER_ROOM_RECONNECT_TIMEOUT_SEC=10
SERVER_ROOM_EMPTY_TIMEOUT_SEC=30
