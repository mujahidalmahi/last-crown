{
  "name": "last-crown-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LAST CROWN — Only One Shall Reign. A browser-based 2D medieval sword-fighting game.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"WEB,SRV\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=@last-crown/web",
    "dev:server": "npm run dev --workspace=@last-crown/server",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace=@last-crown/shared && npm run build --workspace=@last-crown/game-config && npm run build --workspace=@last-crown/game-core",
    "build:apps": "npm run build --workspace=@last-crown/server && npm run build --workspace=@last-crown/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.6",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
